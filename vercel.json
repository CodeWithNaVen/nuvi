{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nuvi-server.vercel.app/api/$1"
    },
    {
      "source": "/live",
      "destination": "https://nuvi-server.vercel.app/live"
    }
  ]
}
