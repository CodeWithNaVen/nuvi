{
  "version": 2,
  "name": "nuvi-server",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "env": {
    "VITE_FRONTEND_URL": "https://nuvi.vercel.app",
    "FRONTEND_URL": "https://nuvi.vercel.app"
  }
}
