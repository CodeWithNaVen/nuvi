# Nuvi — environment variables (all optional; Settings panel is the primary way to configure keys)
# Paste your key in the Nuvi Settings panel once the app is running — these env vars are fallback.

GEMINI_API_KEY="AIzaSy..."

# Desktop agent override (default 127.0.0.1:8765) — LOCAL DEV
# DESKTOP_AGENT_URL=http://127.0.0.1:8765

# Nuvi backend port (default 3000). If changed, also update electron/main.cjs SERVER_PORT.
# NUVI_PORT=3000

# ─────────────────────────────────────────────────────────────────
# PRODUCTION — Vercel Deployments
# ─────────────────────────────────────────────────────────────────
# Backend (Express + WS + Agents) — https://nuvi-server.vercel.app
NUVI_SERVER_URL=https://nuvi-server.vercel.app
VITE_BACKEND_URL=https://nuvi-server.vercel.app
# Frontend (Vite) — https://nuvi.vercel.app
VITE_FRONTEND_URL=https://nuvi.vercel.app
FRONTEND_URL=https://nuvi.vercel.app
# Local fallback (uncomment for dev):
# VITE_BACKEND_URL=http://localhost:3000
# DESKTOP_AGENT_URL=http://127.0.0.1:8765

# Optional: override data dir (default: cwd in dev, %APPDATA%/Nuvi in packaged app)
# NUVI_DATA_DIR=C:\Users\you\AppData\Roaming\Nuvi

# Optional: path to a specific Python interpreter for desktop agent auto-spawn in dev
# NUVI_PYTHON=python

# Optional: pre-built desktop agent exe path (set automatically by Electron when packaged)
# NUVI_AGENT_EXE=
