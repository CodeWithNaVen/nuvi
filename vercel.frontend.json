{
  "version": 2,
  "name": "nuvi",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_BACKEND_URL": "https://nuvi.onrender.com",
    "VITE_FRONTEND_URL": "https://nuviai.vercel.app"
  }
}
