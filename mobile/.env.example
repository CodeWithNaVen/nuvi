# Nuvi Mobile — Expo env (prefix EXPO_PUBLIC_ is exposed to JS)
# Set your LAN IP where the Nuvi server (npm run dev → http://localhost:3000) runs.
# Phone and desktop must be on same Wi-Fi. Find IP via `ipconfig` (Windows) or `ifconfig` (mac).

EXPO_PUBLIC_SERVER_URL=http://192.168.1.71:3000

# Example: use ipconfig IPv4 → EXPO_PUBLIC_SERVER_URL=http://192.168.1.71:3000
